<%layout("/layouts/boilerplate")%>
  <div class="row mt-3">
    <h1 class="col6 offset-2">Sign up</h1>
    <div class="col-6 offset-3">
<form action="/signup" method="post" class="needs-validation" novalidate>
<div class="mb-3">
            <label for="username" class="form-label">username</label>
            <input name="username" placeholder="enter username" class="form-control" id="username" required>
            <div class="valid-feedback">looks good</div>
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">email</label>
            <input name="email" placeholder="enter email" class="form-control" id="email" required>
        </div>
           <div class="mb-3">
            <label for="password" class="form-label">password</label>
            <input type="password" name="password" placeholder="enter password" class="form-control" id="password" required>
        </div>
        <button class="btn btn-success">signup</button>
</form>
    </div>
  </div>